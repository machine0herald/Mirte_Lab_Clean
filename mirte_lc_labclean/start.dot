digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
"Start?" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="Start?", shape=ellipse, style=filled];
"Lab Cleanup Root" [fillcolor=gold, fontcolor=black, fontsize=9, label="Lab Cleanup Root\nSuccessOnAll", shape=parallelogram, style=filled];
"Start?" -> "Lab Cleanup Root";
subgraph cluster_Topics2BB {
    label="Topics2BB";
    color=orange;
    style=filled;
    fillcolor=lemonchiffon;
    node [fontcolor=black, fontsize=9, style=filled, fillcolor=gray];
    Topics2BB [fillcolor=orange, shape=box, label="Ⓜ Topics2BB"];
    Exploration2BB [label=Exploration2BB, shape=ellipse];
    Cancel2BB [label=Cancel2BB, shape=ellipse];
    Start2BB [label=Start2BB, shape=ellipse];
    Battery2BB [label=Battery2BB, shape=ellipse];
    Detectedcloud2BB [label=Detectedcloud2BB, shape=ellipse];
    DetectedClasses2BB [label=DetectedClasses2BB, shape=ellipse];
    "/planar_objects_detected" [label="/planar_objects_detected", shape=box, fillcolor=lightblue, fontcolor=black, style=filled];
    "/cloud_objects_detected" [label="/cloud_objects_detected", shape=box, fillcolor=lightblue, fontcolor=black, style=filled];
    "/battery_low_warning" [label="/battery_low_warning", shape=box, fillcolor=lightblue, fontcolor=black, style=filled];
    "/battery_percentage" [label="/battery_percentage", shape=box, fillcolor=lightblue, fontcolor=black, style=filled];
    "/num_planar_objects_detected" [label="/num_planar_objects_detected", shape=box, fillcolor=lightblue, fontcolor=black, style=filled];
    "/result" [label="/result", shape=box, fillcolor=lightblue, fontcolor=black, style=filled];
    "/start_button" [label="/start_button", shape=box, fillcolor=lightblue, fontcolor=black, style=filled];
    "/num_cloud_objects_detected" [label="/num_cloud_objects_detected", shape=box, fillcolor=lightblue, fontcolor=black, style=filled];
    "/battery" [label="/battery", shape=box, fillcolor=lightblue, fontcolor=black, style=filled];
    "/explore_status" [label="/explore_status", shape=box, fillcolor=lightblue, fontcolor=black, style=filled];
    "/cancel_button" [label="/cancel_button", shape=box, fillcolor=lightblue, fontcolor=black, style=filled];
}
"Lab Cleanup Root" -> Topics2BB;
Topics2BB -> Exploration2BB;
Topics2BB -> Cancel2BB;
Topics2BB -> Start2BB;
Topics2BB -> Battery2BB;
Topics2BB -> Detectedcloud2BB;
Topics2BB -> DetectedClasses2BB;
Tasks [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Tasks", shape=octagon, style=filled];
"Lab Cleanup Root" -> Tasks;
"Battery Low?" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="Battery Low?", shape=ellipse, style=filled];
Tasks -> "Battery Low?";
Dock [fillcolor=gold, fontcolor=black, fontsize=9, label="Dock\nSuccessOnOne", shape=parallelogram, style=filled];
"Battery Low?" -> Dock;
"Flash Red" [fillcolor=gray, fontcolor=black, fontsize=9, label="Flash Red", shape=ellipse, style=filled];
Dock -> "Flash Red";
"Dock Action" [fillcolor=gray, fontcolor=black, fontsize=9, label="Dock Action", shape=ellipse, style=filled];
Dock -> "Dock Action";
"Detected?" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="Detected?", shape=ellipse, style=filled];
Tasks -> "Detected?";
"Approach and Handle" [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ Approach and Handle", shape=box, style=filled];
"Detected?" -> "Approach and Handle";
"Pause Coverage" [fillcolor=gray, fontcolor=black, fontsize=9, label="Pause Coverage", shape=ellipse, style=filled];
"Approach and Handle" -> "Pause Coverage";
Sort [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ Sort", shape=box, style=filled];
"Approach and Handle" -> Sort;
"Flash Green" [fillcolor=gray, fontcolor=black, fontsize=9, label="Flash Green", shape=ellipse, style=filled];
Sort -> "Flash Green";
"Pick Up" [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ Pick Up", shape=box, style=filled];
Sort -> "Pick Up";
Approach [fillcolor=gray, fontcolor=black, fontsize=9, label=Approach, shape=ellipse, style=filled];
"Pick Up" -> Approach;
"Deploy Arm" [fillcolor=gray, fontcolor=black, fontsize=9, label="Deploy Arm", shape=ellipse, style=filled];
"Pick Up" -> "Deploy Arm";
"Pick or Skip" [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Pick or Skip", shape=octagon, style=filled];
"Pick Up" -> "Pick or Skip";
"planar_Detected?" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="planar_Detected?", shape=ellipse, style=filled];
"Pick or Skip" -> "planar_Detected?";
"Pick Object" [fillcolor=gray, fontcolor=black, fontsize=9, label="Pick Object", shape=ellipse, style=filled];
"planar_Detected?" -> "Pick Object";
Idle [fillcolor=gray, fontcolor=black, fontsize=9, label=Idle, shape=ellipse, style=filled];
"Pick or Skip" -> Idle;
"Resume Coverage" [fillcolor=gray, fontcolor=black, fontsize=9, label="Resume Coverage", shape=ellipse, style=filled];
"Approach and Handle" -> "Resume Coverage";
"Idle*" [fillcolor=gray, fontcolor=black, fontsize=9, label="Idle*", shape=ellipse, style=filled];
Tasks -> "Idle*";
"Explore or Cover" [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ Explore or Cover", shape=octagon, style=filled];
"Lab Cleanup Root" -> "Explore or Cover";
"Explored?" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="Explored?", shape=ellipse, style=filled];
"Explore or Cover" -> "Explored?";
CoverageTask [fillcolor=gray, fontcolor=black, fontsize=9, label=CoverageTask, shape=ellipse, style=filled];
"Explored?" -> CoverageTask;
"Idle**" [fillcolor=gray, fontcolor=black, fontsize=9, label="Idle**", shape=ellipse, style=filled];
"Explore or Cover" -> "Idle**";
"/planar_objects_detected" -> "planar_Detected?"  [color=green, constraint=False, weight=0];
DetectedClasses2BB -> "/planar_objects_detected"  [color=blue, constraint=False, weight=0];
"/cloud_objects_detected" -> "Detected?"  [color=green, constraint=False, weight=0];
Detectedcloud2BB -> "/cloud_objects_detected"  [color=blue, constraint=False, weight=0];
Battery2BB -> "/battery_low_warning"  [color=blue, constraint=False, weight=0];
"/battery_percentage" -> "Battery Low?"  [color=green, constraint=False, weight=0];
DetectedClasses2BB -> "/num_planar_objects_detected"  [color=blue, constraint=False, weight=0];
"/result" -> "Send Result"  [color=green, constraint=False, weight=0];
"/start_button" -> "Start?"  [color=green, constraint=False, weight=0];
Start2BB -> "/start_button"  [color=blue, constraint=False, weight=0];
Detectedcloud2BB -> "/num_cloud_objects_detected"  [color=blue, constraint=False, weight=0];
Battery2BB -> "/battery"  [color=blue, constraint=False, weight=0];
"/explore_status" -> "Explored?"  [color=green, constraint=False, weight=0];
Exploration2BB -> "/explore_status"  [color=blue, constraint=False, weight=0];
Cancel2BB -> "/cancel_button"  [color=blue, constraint=False, weight=0];
subgraph Blackboard {
id=Blackboard;
label=Blackboard;
rank=sink;
"Send Result" [color=blue, fillcolor=gray, fontcolor=blue, fontsize=7, label="Send Result", shape=ellipse, style=filled];
}

}
